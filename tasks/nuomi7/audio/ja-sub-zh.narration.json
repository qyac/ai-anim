{
  "source": "./audio/ja-vo.mp3",
  "lines": [
    {
      "id": "s1-1",
      "text": "屋里没人的时候。",
      "start": 0.2,
      "dur": 2.07
    },
    {
      "id": "s2-1",
      "text": "地板、窗台、你的椅子——三层。",
      "start": 4.173,
      "dur": 4.729
    },
    {
      "id": "s3-1",
      "text": "窗外那点响动，有五个来源。",
      "start": 9.423,
      "dur": 3.085
    },
    {
      "id": "s4-1",
      "text": "没人看着的时候，猫才最像自己。",
      "start": 13.396,
      "dur": 4.517
    },
    {
      "id": "s5-1",
      "text": "同一组读数，三种画法。",
      "start": 18.706,
      "dur": 4.267
    },
    {
      "id": "s6-1",
      "text": "屋里没人的时候 · 橘白 · 铃铛。",
      "start": 23.677,
      "dur": 1.883
    }
  ]
}
