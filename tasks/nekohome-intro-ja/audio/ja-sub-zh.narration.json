  "lines": [
    {
      "id": "open-1",
      "text": "介绍一下我们家这位。",
      "start": 0.335,
      "dur": 3.072
    },
    {
      "id": "open-2",
      "text": "一只用代码画出来的猫娘。",
      "start": 3.847,
      "dur": 3.187
    },
    {
      "id": "nuomi-1",
      "text": "橘白毛，琥珀眼，脖子上一颗铃铛。",
      "start": 8.6,
      "dur": 4.648
    },
    {
      "id": "nuomi-2",
      "text": "话很多，还爱逞强。",
      "start": 14.216,
      "dur": 3.76
    },
    {
      "id": "tsundere-1",
      "text": "明明想被摸，先躲开。",
      "start": 19.07,
      "dur": 3.139
    },
    {
      "id": "tsundere-2",
      "text": "真不理她，又偷偷盯着你。",
      "start": 22.607,
      "dur": 4.475
    },
    {
      "id": "xiaoying-1",
      "text": "萧影，总跟她待在一起的那位。",
      "start": 28.796,
      "dur": 3.632
    },
    {
      "id": "xiaoying-2",
      "text": "在学日语，最爱抱着糯米。",
      "start": 32.696,
      "dur": 3.897
    },
    {
      "id": "phrases-1",
      "text": "口头禅这种东西，藏不住。",
      "start": 39.22,
      "dur": 2.231
    },
    {
      "id": "end-1",
      "text": "我们家这位，就这样。",
      "start": 42.952,
      "dur": 2.611
    }
  ]
