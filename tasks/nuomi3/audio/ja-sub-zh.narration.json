  "lines": [
    {
      "id": "s1-1",
      "text": "凌晨两点，猫还醒着。",
      "start": 0.213,
      "dur": 3.329
    },
    {
      "id": "s2-1",
      "text": "天亮前剩下的存货：七条。",
      "start": 4.455,
      "dur": 4.086
    },
    {
      "id": "s3-1",
      "text": "白天装睡，夜里守着灯。",
      "start": 9.859,
      "dur": 4.156
    },
    {
      "id": "s4-1",
      "text": "你睡着以后，这间屋子归我管。",
      "start": 15.26,
      "dur": 4.946
    },
    {
      "id": "s5-1",
      "text": "晚安，笨蛋。",
      "start": 21.26,
      "dur": 4.247
    }
  ]
}
